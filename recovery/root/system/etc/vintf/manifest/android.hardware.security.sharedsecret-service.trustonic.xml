<?xml version="1.0" encoding="utf-8"?>
<!--
    Recovery manifest fragment for the Trustonic SharedSecret HAL.
    See android.hardware.security.secureclock-service.trustonic.xml for why
    recovery needs its own fragment for every KeyMint-related AIDL instance.

    Keep in sync with
    /vendor/etc/vintf/manifest/android.hardware.security.sharedsecret-service.trustonic.xml.
-->
<manifest version="8.0" type="device">
    <hal format="aidl">
        <name>android.hardware.security.sharedsecret</name>
        <fqname>ISharedSecret/default</fqname>
    </hal>
</manifest>