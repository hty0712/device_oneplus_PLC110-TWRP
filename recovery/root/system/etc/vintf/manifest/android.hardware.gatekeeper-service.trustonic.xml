<?xml version="1.0" encoding="utf-8"?>
<!--
    Recovery manifest fragment for the Trustonic Gatekeeper HAL.
    See android.hardware.security.keymint-service.trustonic.xml for why recovery
    needs its own copy: VintfObjectRecovery ignores the device manifest on
    /vendor, and AServiceManager_addService() fails without a declaration.

    Keep in sync with
    /vendor/etc/vintf/manifest/android.hardware.gatekeeper-service.trustonic.xml.
-->
<manifest version="8.0" type="device">
    <hal format="aidl">
        <name>android.hardware.gatekeeper</name>
        <fqname>IGatekeeper/default</fqname>
    </hal>
</manifest>
