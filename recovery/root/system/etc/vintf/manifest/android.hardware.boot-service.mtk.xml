<?xml version="1.0" encoding="utf-8"?>
<!--
    Recovery manifest fragment for the MediaTek boot control HAL.

    update_engine_sideload resolves the A/B slots through
    android.hardware.boot.IBootControl/default before it touches a payload.  An
    A/B OTA sideoaded on TWRP died with

      I BootControlClient.cpp(419)] AIDL IBootControl not available, falling back to HIDL.
      W HidlServiceManagement: hwservicemanager is not supported on the device.
      E BootControlClient.cpp(426)] Error getting bootctrl v1.0 module.
      E sideload_main.cc(147)] Error initializing the BootControlInterface.

    because recovery's servicemanager (VintfObjectRecovery) only reads
    /system/etc/vintf/manifest.xml and the fragments in
    /system/etc/vintf/manifest/, never the vendor manifest.  Without a
    declaration here AServiceManager_addService() rejects the vendor HAL with
    EX_ILLEGAL_ARGUMENT, which is fatal for it:

      I servicemanager: Caller(pid=1978,uid=0,sid=u:r:su:s0) Could not find
          android.hardware.boot.IBootControl/default in the VINTF manifest.
      F android.hardware.boot-service.mtk: Check failed: status == STATUS_OK
          (status=-3) Failed to add service ... -3

    Keep this in sync with
    /vendor/etc/vintf/manifest/android.hardware.boot-service.mtk.xml.
-->
<manifest version="8.0" type="device">
    <hal format="aidl">
        <name>android.hardware.boot</name>
        <version>1</version>
        <fqname>IBootControl/default</fqname>
    </hal>
</manifest>
