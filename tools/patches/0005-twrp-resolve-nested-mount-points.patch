+std::string TWPartitionManager::ResolvePartitionPath(const std::string& path) const {
+  std::string candidate = path;
+  if (candidate.empty() || candidate.front() != '/') candidate.insert(0, 1, '/');
+  while (candidate.size() > 1 && candidate.back() == '/') candidate.pop_back();
+  for (const TWPartition* partition : partitions_) {
+    if (MatchesPath(partition, candidate)) return candidate;
+  }
+  return TWFunc::GetRootPath(path);
+}
