# mount point   fstype  device                                          device2             flags
# Logical partitions
/system         ext4    system                                                              flags=display="System";slotselect;backup=1;mounttodecrypt
/system_ext     ext4    system_ext                                                          flags=display="System_ext";slotselect;backup=1
/product        ext4    product                                                             flags=display="Product";slotselect;backup=1
/vendor         ext4    vendor                                                              flags=display="Vendor";slotselect;backup=1;mounttodecrypt
/odm            ext4    odm                                                                 flags=display="Odm";slotselect;backup=1
/vendor_dlkm    ext4    vendor_dlkm                                                         flags=display="Vendor_dlkm";slotselect;backup=1
/odm_dlkm       ext4    odm_dlkm                                                            flags=display="Odm_dlkm";slotselect;backup=1
/system_dlkm    ext4    system_dlkm                                                         flags=display="System_dlkm";slotselect;backup=1

# OPlus logical partitions
/my_product     ext4    my_product                                                          flags=display="My_product";slotselect
/my_engineering ext4    my_engineering                                                      flags=display="My_engineering";slotselect
/my_company     ext4    my_company                                                          flags=display="My_company";slotselect
/my_carrier     ext4    my_carrier                                                          flags=display="My_carrier";slotselect
/my_region      ext4    my_region                                                           flags=display="My_region";slotselect
/my_heytap      ext4    my_heytap                                                           flags=display="My_heytap";slotselect
/my_stock       ext4    my_stock                                                            flags=display="My_stock";slotselect
/my_preload     ext4    my_preload                                                          flags=display="My_preload";slotselect
/my_bigball     ext4    my_bigball                                                          flags=display="My_bigball";slotselect
/my_manifest    ext4    my_manifest                                                         flags=display="My_manifest";slotselect

# Userdata / metadata
/data           f2fs    /dev/block/by-name/userdata                                          flags=display="Data";wipeingui;usermrf;storage;canbeencrypted;backup=1
/metadata       f2fs    /dev/block/by-name/metadata                                          flags=display="Metadata"
/cache          ext4    /dev/block/by-name/oplusreserve2                                    flags=display="Cache";wipeingui
/persist        ext4    /dev/block/by-name/persist                                          flags=display="Persist";backup=1
/mnt/vendor/protect_f ext4 /dev/block/by-name/protect1                                       flags=display="Protect_f";backup=1
/mnt/vendor/protect_s ext4 /dev/block/by-name/protect2                                       flags=display="Protect_s";backup=1
/mnt/vendor/nvdata ext4 /dev/block/by-name/nvdata                                            flags=display="Nvdata";backup=1
/mnt/vendor/nvcfg  ext4 /dev/block/by-name/nvcfg                                             flags=display="Nvcfg";backup=1

# Boot / recovery images
/boot           emmc    /dev/block/by-name/boot                                             flags=display="Boot";slotselect;backup=1;flashimg=1
/init_boot      emmc    /dev/block/by-name/init_boot                                        flags=display="Init_boot";slotselect;backup=1;flashimg=1
/vendor_boot    emmc    /dev/block/by-name/vendor_boot                                      flags=display="Vendor_boot";slotselect;backup=1;flashimg=1
/dtbo           emmc    /dev/block/by-name/dtbo                                             flags=display="Dtbo";slotselect;backup=1;flashimg=1
/vbmeta         emmc    /dev/block/by-name/vbmeta                                           flags=display="Vbmeta";slotselect;backup=1;flashimg=1
/vbmeta_system  emmc    /dev/block/by-name/vbmeta_system                                    flags=display="Vbmeta_system";slotselect;backup=1;flashimg=1
/vbmeta_vendor  emmc    /dev/block/by-name/vbmeta_vendor                                    flags=display="Vbmeta_vendor";slotselect;backup=1;flashimg=1
/logo           emmc    /dev/block/by-name/logo                                             flags=display="Logo";slotselect;backup=1;flashimg=1
/modem          emmc    /dev/block/by-name/modem                                            flags=display="Modem";slotselect;backup=1
/misc           emmc    /dev/block/by-name/misc                                             flags=display="Misc"
/para           emmc    /dev/block/by-name/para                                             flags=display="Para"
/persistent     emmc    /dev/block/by-name/frp                                              flags=display="FRP";backup=1
/seccfg         emmc    /dev/block/by-name/seccfg                                          flags=display="Seccfg"

# Removable storage
/usbstorage     vfat    /dev/block/sdg1                                 /dev/block/sdg        flags=fsflags=utf8;display="USB Storage";storage;wipeingui;removable