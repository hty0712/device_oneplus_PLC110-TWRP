 // reboot: Reboot the system. Return -1 on error, no return on success
+// MTK's LK reads the Android bootloader control block (BCB) from /misc on
+// every boot, and a pending "boot-recovery" command takes precedence over the
+// reboot reason and over the hardware key combos. Leaving it behind is what
+// makes every reboot - and every key combination - land in recovery again, so
+// the command field is rewritten right before rebooting.
+//
+// Only the 32-byte command field at offset 0 is touched: the A/B slot metadata
+// (bootloader_control) that the bootloader keeps at offset 2048 must survive.
+static bool WriteMiscBootCommand(const char* command) {
+  static const char* kMiscPaths[] = {
+      "/dev/block/by-name/misc",
+      "/dev/block/bootdevice/by-name/misc",
+      "/dev/block/platform/bootdevice/by-name/misc",
+  };
+
+  const char* device = nullptr;
+  for (const char* path : kMiscPaths) {
+    if (access(path, F_OK) == 0) {
+      device = path;
+      break;
+    }
+  }
+  if (device == nullptr) {
+    LOGERR("Unable to find the misc partition; leaving the boot command untouched\n");
+    return false;
+  }
+
+  std::array<char, 32> buffer{};
+  if (command != nullptr) {
+    std::strncpy(buffer.data(), command, buffer.size() - 1);
+  }
+
+  android::base::unique_fd fd(open(device, O_WRONLY | O_SYNC | O_CLOEXEC));
+  if (fd < 0) {
+    LOGERR("Unable to open '%s' for the boot command (%s)\n", device, strerror(errno));
+    return false;
+  }
+  if (pwrite(fd.get(), buffer.data(), buffer.size(), 0) != static_cast<ssize_t>(buffer.size())) {
+    LOGERR("Unable to write the boot command to '%s' (%s)\n", device, strerror(errno));
+    return false;
+  }
+  fsync(fd.get());
+  LOGINFO("BCB command set to '%s' on '%s'\n", buffer.data(), device);
+  return true;
+}
+
+void TWFunc::ClearMiscBootCommand() {
+  WriteMiscBootCommand(nullptr);
+}
